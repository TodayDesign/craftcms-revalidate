{% import "_includes/forms" as forms %}

{% set siteIds = craft.app.sites.getAllSiteIds() %}

{% if selectedSiteId is not defined %}
  {% if craft.app.request.getQueryParam('site') is numeric %}
    {% set selectedSiteId = craft.app.request.getQueryParam('site') %}
  {% else %}
    {% set selectedSiteId = siteIds|first %}
  {% endif %}
{% endif %}

{% set site = craft.app.sites.getSiteById(selectedSiteId) %}

<div class="content">
  <!-- Site selector -->
  <h2>Site</h2>
  {% set groups = craft.app.sites.getAllGroups() %}
  <button type="button" id="context-btn" class="btn menubtn sitemenubtn" data-icon="world">
    {{ site.name|t('site') }}
  </button>
  <div class="menu">
    {% for group in groups %}
      {% set groupSiteIds = group.getSiteIds()|intersect(siteIds) %}
      {% if groupSiteIds %}
        {% if groups|length > 1 %}<h6>{{ group.name|t('site') }}</h6>{% endif %}
        <ul class="padded">
          {% for siteId in groupSiteIds %}
            {% set siteOption = craft.app.sites.getSiteById(siteId) %}
            <li>
              <a{% if siteId == selectedSiteId %} class="sel"{% endif %}
                data-site-id="{{ siteId }}" href="?site={{ siteOption.id }}">
                {{ siteOption.name|t('site') }}
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    {% endfor %}
  </div>
  <!-- Global revalidate -->
  <h2 style="margin-top:40px">General</h2>
  <form style="margin-bottom:4px;" method="post" accept-charset="UTF-8">
    {{ redirectInput('utilities/revalidate-utility?site=' ~ site.id) }}
    {{ csrfInput() }}
    <input type="hidden" name="siteId" value="{{ site.id }}">
    <input type="hidden" name="siteUrl" value="{{ site.baseUrl }}">
    <select name="action" style="padding: 5px; margin-bottom:20px; border:1px solid var(--medium-hairline-color)">
      <option value="revalidate/revalidate/revalidate-all" selected>Clear page cache</option>
      <option value="revalidate/revalidate/revalidate-site-data">Clear global and navigation cache</option>
      <option value="revalidate/revalidate/revalidate-sitemap">Rebuild sitemap</option>
      <option value="revalidate/revalidate/deploy">Deploy site</option>
    </select>
    <br>
    <input type="submit" class="btn submit" value="Submit">
  </form>

  <!-- Revalidate paths -->
  <h2 style="margin-top:40px">Revalidate paths</h2>
  <div style="margin: 10px 0;">
    <form class="utility" method="post" accept-charset="UTF-8">
      {{ actionInput('revalidate/revalidate/revalidate-paths') }}
      {{ redirectInput('utilities/revalidate-utility?site=' ~ site.id) }}
      {{ csrfInput() }}

      <input type="hidden" name="siteId" value="{{ site.id }}">
      <input type="hidden" name="siteUrl" value="{{ site.baseUrl }}">

      {{ forms.editableTableField({
        name: 'paths',
        id: 'paths',
        cols: [{
            type: 'singleline',
            heading: 'Paths',
            placeholder: '/page',
            code: true,
        }],
        addRowLabel: "Add a path",
        allowAdd: true,
        allowDelete: true,
        allowReorder: true,
        first: true,
      }) }}
      <input type="submit" class="btn submit" value="Submit">
    </form>
  </div>

  <!-- Revalidate tags -->
  <h2 style="margin-top:40px">Revalidate tags</h2>
  <div style="margin: 10px 0;">
    <form class="utility" method="post" accept-charset="UTF-8">
      {{ actionInput('revalidate/revalidate/revalidate-tags') }}
      {{ redirectInput('utilities/revalidate-utility?site=' ~ site.id) }}
      {{ csrfInput() }}

      <input type="hidden" name="siteId" value="{{ site.id }}">
      <input type="hidden" name="siteUrl" value="{{ site.baseUrl }}">

      {{ forms.editableTableField({
          name: 'tags',
          id: 'tags',
          cols: [{
              type: 'singleline',
              heading: 'Tags',
              placeholder: 'site-data',
              code: true,
          }],
          addRowLabel: "Add a tag",
          allowAdd: true,
          allowDelete: true,
          allowReorder: true,
          first: true,
      }) }}
      <input type="submit" class="btn submit" value="Submit">
    </form>
  </div>

</div>
